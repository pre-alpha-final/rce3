@implements IAsyncDisposable

<svg class="settings-cogs" viewBox="0 0 64 48" role="img" aria-label="Moving cogs show that the app is running, even when disconnected." focusable="false">
    <title>Blazor runtime activity — independent of the feed connection</title>
    <g class="cog-motion" transform="rotate(@angle 22 23)">
        <path d="m18 5 8 0 1 5 4 2 5-2 4 7-4 3 0 5 4 3-4 7-5-2-4 2-1 5h-8l-1-5-4-2-5 2-4-7 4-3v-5l-4-3 4-7 5 2 4-2Z" />
        <circle cx="22" cy="23" r="6" />
    </g>
    <g class="cog-motion" transform="rotate(@(-angle) 49 33)">
        <path d="m46 21 6 0 1 3 3 2 3-1 3 5-3 2v3l3 2-3 5-3-1-3 2-1 3h-6l-1-3-3-2-3 1-3-5 3-2v-3l-3-2 3-5 3 1 3-2Z" />
        <circle cx="49" cy="33" r="4" />
    </g>
</svg>

@code {
    private readonly CancellationTokenSource stop = new();
    private Task? animation;
    private int angle;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            animation = AnimateAsync();
        }
    }

    private async Task AnimateAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(150));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                await InvokeAsync(() =>
                {
                    angle = (angle + 6) % 360;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (stop.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await stop.CancelAsync();
        if (animation is not null)
        {
            await animation;
        }
        stop.Dispose();
    }
}
